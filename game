  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  computeScale();
}
function computeScale() {
  const baseRef = 420;
  const raw = MIN_DIM / baseRef;
  ISO_SCALE = Math.max(0.35, Math.min(1.0, raw * 0.65 + 0.1));
}
window.addEventListener('resize', resize);
